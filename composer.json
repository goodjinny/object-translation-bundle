{
    "name": "goodjinny/object-translation-bundle",
    "description": "Translate your entities!",
    "type": "symfony-bundle",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Goodjinny\\ObjectTranslationBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Goodjinny\\ObjectTranslationBundle\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "OlexandrK",
            "email": "alex.kalaidzi@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/framework-bundle": "^6.4|^7.0|^8.0",
        "symfony/translation": "^6.4|^7.0|^8.0",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/orm": "^3.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "symfony/phpunit-bridge": "^8.0",
        "zenstruck/foundry": "^2.8",
        "php-cs-fixer/shim": "^3.92",
        "phpstan/phpstan": "^2.1",
        "twig/twig": "^3.22"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
